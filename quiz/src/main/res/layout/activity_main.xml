 <Button android:id="@+id/answer0" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:gravity="center_vertical" android:textAllCaps="false" android:textSize="16sp" android:layout_marginTop="18dp" android:backgroundTint="#FFFFFF" android:textColor="#193F36"/>
 <Button android:id="@+id/answer1" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:gravity="center_vertical" android:textAllCaps="false" android:textSize="16sp" android:layout_marginTop="8dp" android:backgroundTint="#FFFFFF" android:textColor="#193F36"/>
