<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F4F5EE"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
 <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PYNEXIA / QUICK QUIZ" android:textColor="#246A5B" android:textStyle="bold" android:textSize="12sp" android:letterSpacing="0.1" android:layout_marginTop="14dp"/>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Think fast.
